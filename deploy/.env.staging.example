# Copier vers .env.staging dans /opt/alasource-staging sur le serveur, puis compléter les <...>.
# (Ce fichier reste sur le serveur ; il n'est jamais commité.)

# --- Images GHCR (mêmes que la prod, tag :staging géré par le compose) ---
REGISTRY=ghcr.io
IMAGE_NAMESPACE=githubkhadim66/projet_a_la_source

# --- Base de données (mot de passe DIFFÉRENT de la prod) ---
POSTGRES_USER=alasource
POSTGRES_PASSWORD=<mot-de-passe-fort-staging>
POSTGRES_DB=alasource

# Secret d'application DIFFÉRENT de la prod (openssl rand -hex 32)
SECRET_KEY=<secret-64-hex-staging>

# Staging exposé sur le port 8080 de la MÊME machine (prod garde le port 80)
HTTP_PORT=8080
# Servi publiquement en HTTPS par le Caddy de la prod (STAGING_DOMAIN dans .env.prod)
CORS_ORIGINS=https://staging.funtiworld.com,http://158.220.87.172:8080
FRONTEND_URL=https://staging.funtiworld.com

# --- Compte admin + données de démo (utile pour tester) ---
FIRST_ADMIN_EMAIL=admin@funtiworld.com
FIRST_ADMIN_PASSWORD=<mot-de-passe-admin-staging>
SEED_SUPPLIER_PASSWORD=fournisseur123
SEED_DEMO_DATA=1

# E-mails en console (staging) — jamais d'envoi réel depuis le banc de test
EMAIL_BACKEND=console
