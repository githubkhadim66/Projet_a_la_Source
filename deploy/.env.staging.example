# Copier vers .env.staging sur le serveur de staging, puis compléter.
IMAGE_NAMESPACE=<votre-org-github>/<votre-repo>
REGISTRY=ghcr.io

POSTGRES_USER=alasource
POSTGRES_PASSWORD=<mot-de-passe-fort>
POSTGRES_DB=alasource

# openssl rand -hex 32
SECRET_KEY=<secret-64-hex>

HTTP_PORT=8080
CORS_ORIGINS=https://staging.alasource.example
FRONTEND_URL=https://staging.alasource.example

EMAIL_BACKEND=console
