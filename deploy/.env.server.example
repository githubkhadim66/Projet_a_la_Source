# ── Variables du serveur de test (docker-compose.server.yml) ─────────────────
# Copiez ce fichier en .env.server puis remplacez les valeurs.

# URL publique du site (IP du VPS, port 80). Sert au CORS et aux liens des e-mails.
PUBLIC_URL=http://158.220.87.172

# Base de données (interne au docker-compose — mot de passe libre mais non vide)
POSTGRES_USER=alasource
POSTGRES_PASSWORD=CHANGEZ_MOI_mdp_db
POSTGRES_DB=alasource

# Clé de signature des jetons — générez-la : openssl rand -hex 32
SECRET_KEY=CHANGEZ_MOI_avec_openssl_rand_hex_32

# Compte administrateur créé au premier démarrage
FIRST_ADMIN_EMAIL=admin@alasource.fr
FIRST_ADMIN_PASSWORD=CHANGEZ_MOI_mdp_admin

# Mot de passe des comptes fournisseurs de démonstration
SEED_SUPPLIER_PASSWORD=CHANGEZ_MOI_mdp_fournisseur
