# Reverse proxy TLS — Let's Encrypt automatique (prod + staging sur la même machine)

# Production : DOMAIN="funtiworld.com, www.funtiworld.com" (ou ":80" en accès HTTP par IP)
{$DOMAIN} {
	encode gzip

	# Redirection http→https gérée automatiquement par Caddy (SEC-01)
	reverse_proxy frontend:80

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

# Staging : STAGING_DOMAIN="staging.funtiworld.com". Le staging tourne dans un autre
# projet compose, exposé sur le port 8080 de l'hôte : Caddy le joint via l'hôte.
{$STAGING_DOMAIN} {
	encode gzip

	reverse_proxy host.docker.internal:8080

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Robots-Tag "noindex, nofollow"
	}
}
