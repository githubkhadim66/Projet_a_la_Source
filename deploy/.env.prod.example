# Copier vers .env.prod sur le serveur de production, puis compléter.
IMAGE_NAMESPACE=<votre-org-github>/<votre-repo>
REGISTRY=ghcr.io
IMAGE_TAG=latest

DOMAIN=alasource.example

POSTGRES_USER=alasource
POSTGRES_PASSWORD=<mot-de-passe-fort>
POSTGRES_DB=alasource

# openssl rand -hex 32
SECRET_KEY=<secret-64-hex>

CORS_ORIGINS=https://alasource.example
FRONTEND_URL=https://alasource.example

# E-mails transactionnels (SEC-05 : SPF/DKIM sur le domaine)
EMAIL_BACKEND=smtp
SMTP_HOST=smtp.votre-fournisseur.com
SMTP_PORT=587
SMTP_USER=contact@alasource.example
SMTP_PASSWORD=<mot-de-passe-smtp>
EMAIL_FROM=contact@alasource.example
NOTIFY_INTERNAL_EMAIL=equipe@alasource.example
