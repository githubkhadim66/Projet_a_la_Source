# Copier vers .env.prod dans /opt/alasource-prod sur le serveur, puis compléter les <...>.
# (Ce fichier reste sur le serveur ; il n'est jamais commité.)

# --- Images GHCR (doivent correspondre au dépôt, EN MINUSCULES) ---
REGISTRY=ghcr.io
IMAGE_NAMESPACE=githubkhadim66/projet_a_la_source
IMAGE_TAG=latest

# --- Domaines (Caddy active HTTPS Let's Encrypt automatiquement) ---
# Avant que le DNS pointe vers le serveur : DOMAIN=:80 (accès HTTP par IP).
DOMAIN=funtiworld.com, www.funtiworld.com
# Le staging passe par le même Caddy (port 8080 de l'hôte).
STAGING_DOMAIN=staging.funtiworld.com

# --- Base de données ---
POSTGRES_USER=alasource
POSTGRES_PASSWORD=<mot-de-passe-fort>
POSTGRES_DB=alasource

# Secret d'application (générer avec : openssl rand -hex 32)
SECRET_KEY=<secret-64-hex>

# URLs publiques
CORS_ORIGINS=https://funtiworld.com,https://www.funtiworld.com
FRONTEND_URL=https://funtiworld.com

# --- Compte admin initial (créé au 1er démarrage, idempotent) ---
FIRST_ADMIN_EMAIL=admin@funtiworld.com
FIRST_ADMIN_PASSWORD=<mot-de-passe-admin-fort>
SEED_DEMO_DATA=0        # 0 = aucune donnée de démo en production

# --- E-mails ---
# Laisser en "console" tant que le SMTP n'est pas prêt (les e-mails partent dans les logs).
# Passer à "smtp" et renseigner SMTP_* quand le domaine + la messagerie sont configurés.
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=contact@funtiworld.com
NOTIFY_INTERNAL_EMAIL=<email-interne-equipe>
