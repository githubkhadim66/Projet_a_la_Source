# ── Général ──────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true

# ── Base de données ──────────────────────────────────────────────────────────
# Dev : SQLite (défaut). Staging/prod : Postgres.
DATABASE_URL=sqlite:///./alasource.db
# DATABASE_URL=postgresql+psycopg2://alasource:motdepasse@db:5432/alasource

# ── Sécurité (OBLIGATOIRE en staging/prod : générer avec `openssl rand -hex 32`)
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
MAGIC_LINK_EXPIRE_MINUTES=30

# ── CORS / Front ─────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
FRONTEND_URL=http://localhost:5173

# ── Catalogue PDF (remplaçable à chaud, CATA-04) ─────────────────────────────
CATALOGUE_PDF_PATH=./data/catalogue.pdf

# ── E-mails (console en dev, smtp en staging/prod) ───────────────────────────
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=contact@alasource.example
NOTIFY_INTERNAL_EMAIL=equipe@alasource.example

# ── Seed (python -m app.initial_data) ────────────────────────────────────────
FIRST_ADMIN_EMAIL=admin@alasource.example
FIRST_ADMIN_PASSWORD=changeme-admin
SEED_DEMO_DATA=1
SEED_SUPPLIER_PASSWORD=fournisseur123
